+// Research only: exact fixed-cover sight sample; no firing/rate/damage change.
+import * as THREE from 'three';
+export const COVER_STUDY={on:false,handles:new WeakMap(),stats:{}};
+export function coverSight(shooter,target){
+ const q=shooter.sword.rotation(),p=shooter.sword.translation();
+ const origin=new THREE.Vector3(shooter.weapon.muzzleX??0,shooter.weaponCfg.hiltLength+shooter.weaponCfg.bladeLength,0).applyQuaternion(new THREE.Quaternion(q.x,q.y,q.z,q.w)).add(new THREE.Vector3(p.x,p.y,p.z));
+ const handles=COVER_STUDY.handles.get(shooter.world);const samples=[];
+ for(const name of ['pelvis','abdomen','chest','head']){
+  if(name==='head'&&target.decapitated)continue;
+  const b=target.bodies[name];if(!b)continue;const p=b.translation(),r=b.rotation();
+  for(const side of name==='chest'?[-.14,0,.14]:[0]){
+   const point=new THREE.Vector3(0,0,side).applyQuaternion(new THREE.Quaternion(r.x,r.y,r.z,r.w)).add(new THREE.Vector3(p.x,p.y,p.z));
+   const dir=point.clone().sub(origin),length=dir.length();dir.multiplyScalar(1/Math.max(length,1e-9));
+   const hit=handles&&shooter.world.castRay({origin,dir},Math.max(0,length-.01),true,undefined,undefined,undefined,undefined,c=>handles.has(c.handle));
+   samples.push({name,side,blocked:!!hit});
+  }
+ }
+ return {origin:{...origin},samples,blocked:samples.length>0&&samples.every(s=>s.blocked),fraction:samples.filter(s=>s.blocked).length/Math.max(1,samples.length)};
+}
