    {
      "source_path": "src/schools.js",
      "line": 1178,
      "text": "const IT_FORTE_SECONDA = { name: '뻗은 2번 자세 (세콘다)', desc: '뻗은 칼 밑동으로 받는다', pad: G.ochsR, hand: [0.55, 0.16, 0.2], blade: [-4, -4], pelvisYaw: -45, chestYaw: -55, pitch: 10, drop: 0.12, src: 'Capo Ferro 1610 [16](용어 2) · [21](용어 7) · [29](용어 15) [원문 영역] · 손 · 칼끝 · 몸 = 이탈리아 자세표 2번 자세 값(Fabris 1606 [21]·[22] 판 3·4) [해석]' };"
    },
    {
      "source_path": "src/schools.js",
      "line": 1179,
      "text": "const IT_FORTE_TERZA = { name: '뻗은 3번 자세 (테르차)', desc: '곧은 줄로 치며 막는다', pad: G.langort, hand: [0.68, 0.08, 0.1], blade: [-3, 0], pelvisYaw: -35, chestYaw: -45, pitch: 10, drop: 0.12, src: 'Capo Ferro 1610 [115] · [21](용어 7) · [29](용어 15) [원문 영역] · 손 · 칼끝 · 몸 = 한손 찌르기 틀 긴 자세 값(이탈리아 자세표 뻗은 3번 자세 — Fabris 1606 [28] 판 10) · 낮춤 0.12 [해석]' };"
    },
    {
      "source_path": "src/schools.js",
