--- /dev/null
+++ b/tools/pwa/sw-template.js
@@ -0,0 +1,78 @@
+/* Generated by tools/pwa/build.mjs. Each installation is a complete, verified build. */
+'use strict';
+const VERSION = __PWA_VERSION__;
+const FILES = __PWA_FILES__;
+const SCOPE = self.registration.scope;
+const PREFIX = `stillness-pwa:${SCOPE}:`;
+const CACHE = PREFIX + VERSION;
+const canonical = new Map(FILES.map(file => [new URL(file.path, SCOPE).href, file]));
+const digest = async bytes => [...new Uint8Array(await crypto.subtle.digest('SHA-256', bytes))]
+  .map(n => n.toString(16).padStart(2, '0')).join('');
+
+self.addEventListener('install', event => {
+  event.waitUntil((async () => {
+    const cache = await caches.open(CACHE);
+    let cursor = 0;
+    try {
+      // Bound concurrent downloads and hashing on phones. Do not keep a partial build.
+      const results = await Promise.allSettled(Array.from({ length: Math.min(4, FILES.length) }, async () => {
+        while (cursor < FILES.length) {
+          const file = FILES[cursor++], url = new URL(file.path, SCOPE).href;
+          const response = await fetch(url, { cache: 'no-store', credentials: 'same-origin', redirect: 'error' });
+          if (!response.ok || response.status !== 200 || response.type === 'opaque') throw new Error('PWA download failed');
+          const bytes = await response.clone().arrayBuffer();
+          if (bytes.byteLength !== file.bytes || await digest(bytes) !== file.sha256) throw new Error('PWA build mismatch');
+          await cache.put(url, response);
+        }
+      }));
+      const failed = results.find(result => result.status === 'rejected');
+      if (failed) throw failed.reason;
+    } catch (error) {
+      // All writers have settled, so none can recreate a partial cache.
+      await caches.delete(CACHE);
+      throw error;
+    }
+    // Intentionally no skipWaiting. Open games continue using their existing build.
+  })());
+});
+
+self.addEventListener('activate', event => {
+  event.waitUntil((async () => {
+    try {
+      const names = await caches.keys();
+      await Promise.allSettled(names.filter(name => name.startsWith(PREFIX) && name !== CACHE).map(name => caches.delete(name)));
+    } catch { /* Old-cache cleanup must not prevent a verified build from activating. */ }
+    // No clients.claim(): an already open, uncontrolled game is not taken over.
+  })());
+});
+
+self.addEventListener('fetch', event => {
+  const request = event.request;
+  if (request.method !== 'GET') return;
+  const url = new URL(request.url), scope = new URL(SCOPE);
+  if (url.origin !== scope.origin || !url.pathname.startsWith(scope.pathname)) return;
+  let key = new URL(url.pathname, url.origin).href;
+  if (request.mode === 'navigate' && url.pathname === scope.pathname) key = new URL('index.html', SCOPE).href;
+  if (!canonical.has(key)) return; // Other apps, old experiments and APIs are never cached here.
+  event.respondWith((async () => {
+    let cache;
+    try {
+      cache = await caches.open(CACHE);
+      const stored = await cache.match(key);
+      if (stored) return stored;
+    } catch { /* Storage may become unavailable even after a successful installation. */ }
+    // Eviction/storage failure must not silently mix a newer server build into this one.
+    const file = canonical.get(key);
+    try {
+      const response = await fetch(key, { cache: 'no-store', credentials: 'same-origin', redirect: 'error' });
+      if (response.status !== 200) throw new Error('PWA asset missing');
+      const bytes = await response.clone().arrayBuffer();
+      if (bytes.byteLength !== file.bytes || await digest(bytes) !== file.sha256) throw new Error('PWA build mismatch');
+      try { if (cache) await cache.put(key, response.clone()); } catch { /* Online verified bytes remain usable. */ }
+      return response;
+    } catch {
+      return new Response('이 버전의 게임 자료가 없습니다. 인터넷에 연결한 뒤 게임 창을 모두 닫고 다시 열어 주세요.',
+        { status: 503, headers: { 'Content-Type': 'text/plain; charset=utf-8', 'Cache-Control': 'no-store' } });
+    }
+  })());
+});
