@@ -0,0 +1,136 @@
+// Opt-in recovery research. Thresholds below are engineering trial parameters,
+// not measured human limits. Normal play never constructs this controller.
+import * as THREE from 'three';
+import { BODY } from './config.js';
+
+const PARTS = ['footF', 'footB', 'shinF', 'shinB', 'farmS', 'farmO'];
+const clamp = THREE.MathUtils.clamp;
+
+/** Read the previous completed physics step, not Gait's retained stance loads. */
+export function recoveryContacts(f) {
+  const out = {};
+  for (const name of PARTS) {
+    const body = f.bodies[name];
+    const row = out[name] = { impulse: 0, speed: 0, points: 0 };
+    for (let c = 0; c < body.numColliders(); c++) {
+      const collider = body.collider(c);
+      f.world.contactPairsWith(collider, (other) => {
+        if (!other.parent()?.isFixed()) return;
+        f.world.contactPair(collider, other, (m) => {
+          // Exclude walls. Current arenas have fixed horizontal floors.
+          if (Math.abs(m.normal().y) < 0.8) return;
+          let impulse = 0;
+          for (let i = 0; i < m.numContacts(); i++) impulse += m.contactImpulse(i);
+          if (impulse <= 0) return;
+          row.impulse += impulse * Math.abs(m.normal().y);
+          for (let i = 0; i < m.numSolverContacts(); i++) {
+            if (m.solverContactDist(i) > 0.01) continue;
+            const v = body.velocityAtPoint(m.solverContactPoint(i));
+            row.speed = Math.max(row.speed, Math.hypot(v.x, v.z));
+            row.points++;
+          }
+        });
+      });
+    }
+    row.loaded = row.points > 0 && row.impulse > 1e-5;
+  }
+  return out;
+}
+
+export class Recovery {
+  constructor(f) {
+    this.f = f;
+    this.reset();
+  }
+
+  reset() {
+    this.progress = 0;
+    this.stableTime = 0;
+    this.unsupportedTime = 0;
+    this.yielding = false;
+    this.contacts = null;
+    this.plants = {};
+    this.reason = 'kneeling';
+  }
+
+  update(dt) {
+    const f = this.f;
+    this.contacts = recoveryContacts(f);
+    const c = this.contacts;
+    this.supported = PARTS.some((p) => c[p].loaded);
+    this.unsupportedTime = this.supported ? 0 : this.unsupportedTime + dt;
+    if (f.stateTime < f.kneelTime) return;
+    if (f.legHealth < 0.25) {
+      this.reason = 'leg-capacity';
+      f.setState('kneel');
+      return;
+    }
+    if (this.unsupportedTime > 0.25) {
+      this.reason = 'no-support';
+      f.knockDown(true);
+      return;
+    }
+    if (this.yielding) {
+      this.progress = Math.max(0, this.progress - dt / 0.45);
+      if (this.progress === 0) f.setState('kneel');
+      return;
+    }
+    // Knees/forearms can support the preparation; at least a foot must support
+    // extension. Lost contact pauses extension instead of finishing a timer.
+    const foot = c.footF.loaded || c.footB.loaded;
+    if (this.supported && (this.progress < 0.35 || foot)) {
+      this.progress = Math.min(1, this.progress + dt / f.riseTime);
+    }
+    const v = f.bodies.pelvis.linvel();
+    const height = f.bodies.pelvis.translation().y;
+    const ready = this.progress >= 1 && c.footF.loaded && c.footB.loaded
+      && Math.max(c.footF.speed, c.footB.speed) < 0.4
+      && Math.hypot(v.x, v.z) < 0.5 && v.y > -0.25
+      && height > BODY.standHeight - 0.16
+      && f.tiltDeg() - THREE.MathUtils.radToDeg(f.hunch) < 35;
+    this.stableTime = ready ? this.stableTime + dt : 0;
+    this.reason = ready ? 'settling' : 'finding-support';
+    if (this.stableTime >= 0.1) {
+      this.reason = 'supported-handover';
+      f.setState('stand');
+      f.balance = 60;
+      f.offBalanceTime = 0;
+    } else if (f.stateTime > f.kneelTime + 2 * f.riseTime + 0.5) {
+      this.reason = 'support-timeout';
+      this.yielding = true;
+    }
+  }
+
+  /** Use the ordinary joint motors; no teleport, added force or rigid foot pin. */
+  pose() {
+    const f = this.f;
+    if (!this.contacts || this.progress <= 0) return;
+    for (const side of ['F', 'B']) {
+      const l = f.gait.legs[side];
+      const names = [l.thigh, l.shin, l.foot];
+      const foot = f.bodies[l.foot];
+      if (!this.contacts[l.foot].loaded) {
+        delete this.plants[side];
+        continue;
+      }
+      const ankleJoint = f.jointByName[l.foot];
+      const hipJoint = f.jointByName[l.thigh];
+      const ankle = new THREE.Vector3().copy(ankleJoint.joint.anchor2())
+        .applyQuaternion(new THREE.Quaternion().copy(foot.rotation())).add(foot.translation());
+      const hip = new THREE.Vector3().copy(hipJoint.joint.anchor1())
+        .applyQuaternion(new THREE.Quaternion().copy(f.bodies.pelvis.rotation())).add(f.bodies.pelvis.translation());
+      const forward = new THREE.Vector3(1, 0, 0).applyQuaternion(new THREE.Quaternion().copy(foot.rotation()));
+      let plant = this.plants[side];
+      if (!plant) plant = this.plants[side] = { point: ankle.clone(), yaw: Math.atan2(-forward.z, forward.x) };
+      // Let a slipping contact relocate the target; don't pull a lost foothold
+      // back to an arbitrarily old point through the ground.
+      const delta = ankle.clone().sub(plant.point); delta.y = 0;
+      if (delta.length() > 0.04) plant.point.addScaledVector(delta, 1 - 0.04 / delta.length());
+      plant.point.y = ankle.y;
+      const old = names.map((name) => f.jointByName[name].target.clone());
+      f.gait.legIK(l, hip, plant.point, plant.yaw, 0);
+      const weight = THREE.MathUtils.smoothstep(this.progress, 0, 0.35);
+      names.forEach((name, i) => f.jointByName[name].target.copy(old[i].slerp(f.jointByName[name].target, weight)));
+    }
+  }
+}
